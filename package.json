{
  "name": "vmodv",
  "version": "1.0.0",
  "description": "VmodV — a modular audio visualisation environment built with Electron and Vue",
  "main": "./out/main/index.js",
  "author": "fayaaz",
  "homepage": "https://github.com/fayaaz/modV",
  "scripts": {
    "build": "electron-vite build",
    "build:linux": "yarn build && electron-builder --linux",
    "build:mac": "yarn build && electron-builder --mac",
    "build:unpack": "yarn build && electron-builder --dir",
    "build:win": "yarn build && electron-builder --win",
    "dev": "electron-vite dev",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "postinstall": "patch-package && electron-builder install-app-deps",
    "start": "electron-vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@babel/plugin-syntax-class-properties": "^7.12.13",
    "@ckpack/vue-color": "^1.6.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/remote": "^2.1.4",
    "animated-gif-detector": "^1.2.0",
    "animejs": "^3.2.1",
    "canvas-text-wrapper": "github:cyberj/canvas-text-wrapper#master",
    "chokidar": "2.1.8",
    "color": "^5.0.3",
    "electron-updater": "^6.8.11",
    "fluent-ffmpeg": "^2.1.3",
    "fuse.js": "^7.5.0",
    "golden-layout": "^2.6.0",
    "grandiose": "github:vcync/grandiose-send-arm#31969cc77fe87ba2df183bfa19d37f25a01f2e11",
    "hapticjs": "^1.0.7",
    "interactive-shader-format": "github:vcync/interactive-shader-format-js#78b62b6f4c787b870852df4c8e7b1131e331d8a6",
    "lodash.get": "^4.4.2",
    "lodash.set": "^4.3.2",
    "mathjs": "^15.2.0",
    "meyda": "^5.6.3",
    "node-osc": "^11.7.1",
    "npm": "6.14.6",
    "ospath": "^1.2.2",
    "pex-context": "^2.11.0-2",
    "promise-worker": "^2.0.1",
    "promise-worker-transferable": "^1.0.4",
    "recursive-deps": "^1.1.1",
    "stream-to-blob": "^2.0.1",
    "tap-tempo": "^0.1.1",
    "three": "^0.187.0",
    "uuid": "^14.0.3",
    "vue": "^3.5.45",
    "vue3-smooth-dnd": "^0.0.6",
    "vuex": "^4.1.0",
    "vuex-persistedstate": "^4.1.0",
    "webpack": "3.12.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-playwright-helpers": "^3.1.2",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.65.0",
    "playwright-core": "^1.65.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.7",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2"
  }
}
